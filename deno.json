{
  "tasks": {
    "dev": "deno run --watch main.ts",
    "build": "deno compile -RWN main.ts",
    "build-x86_64": "deno compile -RWN --target x86_64-unknown-linux-gnu main.ts",
    "build-aarch64": "deno compile -RWN --target aarch64-unknown-linux-gnu main.ts"
  },
  "imports": {
    "@types/luxon": "npm:@types/luxon@^3.7.1",
    "cli-loading-animation": "npm:cli-loading-animation@^1.0.6",
    "log-update": "npm:log-update@^7.0.1",
    "luxon": "npm:luxon@^3.7.2",
    "octokit": "npm:octokit@^5.0.3",
    "p-limit": "npm:p-limit@^7.1.1",
    "yaml": "npm:yaml@^2.8.1"
  },
  "fmt": {
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
